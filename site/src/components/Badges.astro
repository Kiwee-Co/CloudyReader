---
// A row of badges: static SVG files in public/img/badges, a light and a dark rendering each,
// shown by the site's theme like the figures. Each badge links to the page that explains it.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const BADGES = {
	platform: { alt: 'Platform: macOS, Apple silicon', href: '/manual/getting-started/#check-your-mac' },
	'voice-engines': { alt: 'Voice engines: on your Mac', href: '/manual/concepts/voice-engines/' },
	'voice-download': {
		alt: 'Voices: download at first launch',
		href: '/manual/getting-started/#let-the-voices-download',
	},
	telemetry: { alt: 'Telemetry: none', href: '/about/privacy/' },
	license: { alt: 'License: Apache-2.0', href: '/about/licenses/' },
};
interface Props {
	names: (keyof typeof BADGES)[];
}
const { names } = Astro.props;
// The build runs in site/, so the files sit in public/img/badges; a missing one fails the build.
// The size attributes come from the file, so the row keeps its size while the images load.
const size = (file: string) => {
	const svg = readFileSync(join(process.cwd(), 'public', 'img', 'badges', file), 'utf8');
	const [, width, height] = svg.match(/<svg[^>]*\swidth="(\d+)"[^>]*\sheight="(\d+)"/) ?? [];
	return { width, height };
};
---

<ul class="cr-badges not-content">
	{
		names.map((name) => (
			<li>
				<a href={BADGES[name].href}>
					{['light', 'dark'].map((theme) => (
						<img
							class={`cr-badge cr-badge--${theme}`}
							src={`/img/badges/${name}-${theme}.svg`}
							{...size(`${name}-${theme}.svg`)}
							alt={BADGES[name].alt}
						/>
					))}
				</a>
			</li>
		))
	}
</ul>

<style>
	.cr-badges {
		--cr-badge-radius: 6px; /* the corner radius drawn in the SVG files */
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		list-style: none;
	}
	/* The focus ring follows the badge's corners. */
	.cr-badges a {
		display: block;
		border-radius: var(--cr-badge-radius);
	}
	.cr-badge {
		display: block;
	}
	.cr-badge--dark,
	:global(:root[data-theme='dark']) .cr-badge--light {
		display: none;
	}
	:global(:root[data-theme='dark']) .cr-badge--dark {
		display: block;
	}
	@media print {
		.cr-badge--light,
		:global(:root[data-theme='dark']) .cr-badge--light {
			display: block;
		}
		.cr-badge--dark,
		:global(:root[data-theme='dark']) .cr-badge--dark {
			display: none;
		}
	}
</style>
